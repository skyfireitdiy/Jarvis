{
  "name": "Jarvis Web Gateway",
  "short_name": "Jarvis",
  "description": "Jarvis Web Gateway PWA",
  "start_url": "/",
  "scope": "/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone", "minimal-ui"],
  "background_color": "#060911",
  "theme_color": "#060911",
  "icons": [
    {
      "src": "/icons/jarvis-pet.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/jarvis-pet-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/jarvis-pet-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
