#!/usr/bin/env bash
# Jarvis 提交前防护：扫描暂存区内容，拦截疑似真实凭据（密钥/token/私钥等）。
#
# 背景：历史上曾有 .jarvis/memory 中的真实 API token 被提交并推送到公开仓库。
# 本 hook 在每次 git commit 前检查本次暂存的改动，发现疑似真实凭据即中止提交。
#
# 扫描器（两者依次执行，任一命中即中止提交，互为补充）：
#   1. Gitleaks（若已安装）：规则覆盖广（AWS/GitHub/私钥/高熵 token 等）。
#      未安装时提示运行 scripts/install-gitleaks.sh 安装。
#   2. 自研轻量扫描器（零依赖）：补充 Gitleaks 默认规则未覆盖的「通用赋值型
#      口令」场景（如 db_password = "..." / DB_PASSWORD="..."）。
#   注意：两者是「与」关系而非「或」——装了 Gitleaks 后仍必须跑自研扫描器，
#   否则通用明文口令会漏检（Gitleaks 默认规则不匹配 password 赋值）。
#
# 启用方式（每个克隆需执行一次）：
#   git config core.hooksPath .githooks
# 或运行 scripts/install-git-hooks.sh
#
# 紧急绕过（不推荐，且会在提交信息中留下记录）：
#   JARVIS_ALLOW_SECRETS=1 git commit ...
set -euo pipefail

# 允许显式绕过（例如提交测试样本）
if [ "${JARVIS_ALLOW_SECRETS:-0}" = "1" ]; then
    echo "[pre-commit] JARVIS_ALLOW_SECRETS=1，跳过凭据扫描。" >&2
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# 先跑 Gitleaks（若已安装），再跑自研扫描器；两者任一命中即中止提交。
GITLEAKS_BIN="$(command -v gitleaks || true)"
if [ -z "$GITLEAKS_BIN" ]; then
    echo "[pre-commit] 未检测到 gitleaks，仅使用自研轻量扫描器。" >&2
    echo "[pre-commit] 建议安装 Gitleaks 以获得更全面的检测：bash scripts/install-gitleaks.sh" >&2
else
    # 使用 gitleaks 扫描暂存区。
    # 注意：gitleaks git 子命令即使发现泄漏也返回 0，但配合 --report-path 时，
    # 有泄漏返回 1、无泄漏返回 0（已实测验证），故可直接用退出码判断。
    TMP_REPORT="$(mktemp)"
    trap 'rm -f "$TMP_REPORT"' EXIT

    if ! "$GITLEAKS_BIN" git --no-banner --staged --redact=20 \
            --report-format json --report-path "$TMP_REPORT" . >/dev/null 2>&1; then
        echo "[pre-commit] Gitleaks 检测到疑似真实凭据，已中止提交。" >&2
        echo "[pre-commit] 详细报告（已脱敏）：" >&2
        python3 - "$TMP_REPORT" <<'PYEOF'
import json, sys
try:
    findings = json.load(open(sys.argv[1]))
except Exception:
    findings = []
for f in findings:
    print(f"  - {f.get('File','?')}:{f.get('StartLine','?')} 规则={f.get('RuleID','?')} 内容={f.get('Secret','')[:25]}")
PYEOF
        echo "[pre-commit] 请移除或修正上述疑似凭据后重试；如确为误报，请更新 .gitleaks.toml 白名单。" >&2
        exit 1
    fi
fi

# 自研扫描器始终执行：补充 Gitleaks 默认规则未覆盖的通用赋值型口令
# （如 db_password = "..." / DB_PASSWORD="..."）。命中时其自身以退出码 1 中止提交。
exec python3 "$REPO_ROOT/.githooks/scan_staged_secrets.py"
